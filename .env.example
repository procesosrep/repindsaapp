# Copia a .env sólo para configuración local; en GoDaddy usa su panel.
# Nunca subas valores privados al repositorio.
APP_ORIGIN=https://tu-dominio.example
DATABASE_URL=
DATABASE_AUTH_TOKEN=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Sólo para restaurar el respaldo cifrado existente:
MIGRATION_IMPORT_KEY=
# Para una instalación nueva y vacía, configura MIGRATION_AUTO_IMPORT=0.
# En desarrollo la importación está desactivada salvo MIGRATION_AUTO_IMPORT=1.
# PORT lo asigna el alojamiento: no es el puerto HTTPS público (443).
