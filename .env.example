# En GoDaddy configura estos nombres en Secretos; no subas valores privados a GitHub.
APP_ORIGIN=https://tu-dominio.example
# GoDaddy proporciona estas variables para su MySQL alojado:
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Sólo si la guía del proveedor exige TLS, usa DB_SSL=true y su CA confiable.
# DB_SSL=true
# DB_SSL_CA=
# Primer administrador: crea tus valores privados y retíralos después del primer acceso.
ADMIN_USERNAME=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
# Instalación nueva, sin importar el respaldo antiguo.
MIGRATION_AUTO_IMPORT=0
# PORT lo asigna el alojamiento. Los adjuntos se guardan en MySQL.
# No hacen falta DATABASE_URL, DATABASE_AUTH_TOKEN, S3_* ni MIGRATION_IMPORT_KEY.
