# Copia a .env sólo para configuración local; en GoDaddy usa su panel.
# Nunca subas valores privados al repositorio.
APP_ORIGIN=https://tu-dominio.example
DATABASE_URL=
DATABASE_AUTH_TOKEN=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Instalación nueva: no requiere clave del respaldo.
MIGRATION_AUTO_IMPORT=0
# Primer administrador: define valores privados en GoDaddy y retíralos tras crearlo.
ADMIN_USERNAME=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
# Restauración opcional: sólo se ejecuta con MIGRATION_AUTO_IMPORT=1
# y MIGRATION_IMPORT_KEY configurada.
# PORT lo asigna el alojamiento: no es el puerto HTTPS público (443).
